#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from std_srvs.srv import Trigger
from mycobot_interfaces.srv import Move
import numpy as np
import cv2

class ChatClient(Node):
    def __init__(self):
        super().__init__('chat_client')

        # ===== 원래 캘리브레이션 값 =====
        pts_pixel = np.array([
            [440.0, 280.0],     # 좌상단
            [440.0, 500.0],     # 좌하단  
            [970.0, 500.0],     # 우하단
            [970.0, 280.0]      # 우상단
        ], dtype=np.float32)
        
        pts_robot = np.array([
            [126.4, -202.9],    # 좌상단
            [299.9, -200.6],    # 좌하단
            [300.3, 208.0],     # 우하단
            [125.2, 208.3]      # 우상단
        ], dtype=np.float32)
        
        self.H, _ = cv2.findHomography(pts_pixel, pts_robot)

        # ===== ROI 설정 =====
        self.roi_x = 440
        self.roi_y = 280
        self.roi_w = 530
        self.roi_h = 220
        self.roi_center_x = self.roi_x + self.roi_w / 2  # 705
        self.roi_center_y = self.roi_y + self.roi_h / 2  # 390

        # 안전 최소 Z값
        self.z_min_safe = 140.0
        
        self.get_logger().info("=" * 60)
        self.get_logger().info("좌표 변환 시스템 (픽셀 보정 비활성화)")
        self.get_logger().info(f"  ROI: ({self.roi_x}, {self.roi_y}, {self.roi_w}, {self.roi_h})")
        self.get_logger().info(f"  ROI 중앙: ({self.roi_center_x:.0f}, {self.roi_center_y:.0f})")
        self.get_logger().info(f"  최소 안전 Z: {self.z_min_safe:.1f} mm")
        self.get_logger().info("=" * 60)

        # 서비스 클라이언트
        self.chat_cli = self.create_client(Trigger, 'chat_service')
        while not self.chat_cli.wait_for_service(timeout_sec=1.0):
            self.get_logger().info('chat_service 대기중...')

        self.move_cli = self.create_client(Move, 'move_service')
        while not self.move_cli.wait_for_service(timeout_sec=1.0):
            self.get_logger().info('move_service 대기중...')

        self.call_chat_service()

    def correct_pixel(self, x, y):
        """
        픽셀 좌표 보정 - 비활성화 (테스트용)
        필요시 여기서 간단한 고정 오프셋 추가
        """
        # ===== 보정 비활성화 =====
        self.get_logger().info(f"📐 픽셀: ({x}, {y}) → 보정 안함")
        return x, y
        
        # ===== 필요시 아래 주석 해제하여 고정 오프셋 사용 =====
        # x_offset = 0   # 테스트 후 조정 (-10 ~ +10)
        # y_offset = 0   # 테스트 후 조정 (-10 ~ +10)
        # 
        # corrected_x = x + x_offset
        # corrected_y = y + y_offset
        # 
        # self.get_logger().info(f"📐 픽셀: ({x}, {y}) → ({corrected_x}, {corrected_y})")
        # self.get_logger().info(f"   offset: X{x_offset:+d}, Y{y_offset:+d}")
        # return int(corrected_x), int(corrected_y)

    def call_chat_service(self):
        req = Trigger.Request()
        future = self.chat_cli.call_async(req)
        future.add_done_callback(self.handle_chat_response)

    def handle_chat_response(self, future):
        try:
            response = future.result()
            if response.success:
                service_name = response.message.strip()
                self.get_logger().info(f"[chat_service 응답] 선택된 서비스: {service_name}")

                cli = self.create_client(Trigger, service_name)
                while not cli.wait_for_service(timeout_sec=1.0):
                    self.get_logger().info(f"{service_name} 대기중...")

                req = Trigger.Request()
                future2 = cli.call_async(req)
                future2.add_done_callback(self.handle_find_angle_response)

            else:
                self.get_logger().warn(f"chat_service 실패: {response.message}")
                self.call_chat_service()

        except Exception as e:
            self.get_logger().error(f"chat_service 예외: {e}")
            self.call_chat_service()

    def handle_find_angle_response(self, future):
        try:
            result = future.result()
            if result and result.success:
                self.get_logger().info(f"[find_angle 응답] {result.message}")

                # 메시지 파싱: "Center:(x,y)/Angle:각도/Depth:TCP높이/picking:색상"
                k2 = result.message.split("/")
                parsed_data = []
                for i in range(4):
                    a = k2[i].replace(' ', '').split(":")[-1].strip('(').strip(")")
                    parsed_data.append(a)
                
                # 픽셀 좌표 추출
                m, n = parsed_data[0].split(',')
                u, v = int(m), int(n)
                
                self.get_logger().info("=" * 60)
                self.get_logger().info(f"📍 원본 픽셀: ({u}, {v})")
                
                # ===== 픽셀 보정 적용 =====
                u_corrected, v_corrected = self.correct_pixel(u, v)
                
                # 호모그래피 변환
                uv_h = np.array([[[u_corrected, v_corrected]]], dtype=np.float32)
                XY = cv2.perspectiveTransform(uv_h, self.H)
                X, Y = XY[0][0]
                
                # Z값
                Z_pick = float(parsed_data[2])

                if Z_pick < self.z_min_safe:
                    self.get_logger().warn(f"🚨 Z값 안전 보정: {Z_pick:.2f} → {self.z_min_safe:.2f} mm")
                    Z_pick = self.z_min_safe

                self.get_logger().info(f"🔄 로봇 좌표: X={X:.2f}, Y={Y:.2f}, Z={Z_pick:.2f}")
                self.get_logger().info("=" * 60)
                
                # 각도와 색상
                angle_str = parsed_data[1]
                color_name = parsed_data[3]
                
                # 색상 약자 변환
                color_abbr_map = {
                    "빨간색": "r",
                    "노란색": "y",
                    "초록색": "g",
                    "파란색": "b",
                    "주황색": "o"
                }
                color_abbr = color_abbr_map.get(color_name, "x")
                
                # 최종 문자열
                xy_str = f"{X:.2f},{Y:.2f}"
                final_str = f"['{xy_str}', '{angle_str}', '{color_abbr}', '{Z_pick:.2f}']"
                
                self.get_logger().info(f"🎯 robot_move로 전송: {final_str}")

                # move_service 호출
                move_req = Move.Request()
                move_req.result = final_str
                future3 = self.move_cli.call_async(move_req)
                future3.add_done_callback(self.handle_move_response)
            else:
                self.get_logger().warn(f"find_angle 실패 또는 응답 없음")
                self.call_chat_service()
        except Exception as e:
            self.get_logger().error(f"find_angle 예외: {e}")
            import traceback
            self.get_logger().error(traceback.format_exc())
            self.call_chat_service()

    def handle_move_response(self, future):
        try:
            response = future.result()
            if response.success:
                self.get_logger().info(f"[move_service 완료] {response.feedback}")
            else:
                self.get_logger().warn(f"move_service 실패: {response.feedback}")
        except Exception as e:
            self.get_logger().error(f"move_service 예외: {e}")

        self.call_chat_service()

    
def main(args=None):
    rclpy.init(args=args)
    node = ChatClient()
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == "__main__":
    main()